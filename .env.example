# ==============================================
# MindAnchor Docker Environment Configuration
# ==============================================

# Database Settings
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mindanchor
DB_PORT=5432

# Node.js Backend Settings
PORT=5000
JWT_SECRET=replace_with_a_unique_64_byte_random_secret

# Google Gemini API Key for Python RAG Microservice
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Shared secret for Node-to-RAG service requests (use a random value of at least 32 bytes)
RAG_SERVICE_API_KEY=replace_with_a_unique_random_secret
